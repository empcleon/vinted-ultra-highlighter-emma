{
  "manifest_version": 3,
  "name": "Vinted UltraSniper - Emma",
  "version": "1.2",
  "description": "Sniper avanzado para Vinted España: ultra-filtros, detección de urgentes, variaciones ortográficas y notificaciones.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.vinted.es/*",
    "https://vinted.*/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vinted UltraSniper"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.es/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
